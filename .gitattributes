# Git attributes for cross-platform compatibility
# https://help.github.com/articles/dealing-with-line-endings/

# Auto detect text files and normalize line endings to LF
* text=auto

# Java files
*.java text eol=lf

# Text files
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.class binary
*.jar binary
*.exe binary
*.o binary
